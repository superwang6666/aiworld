# LLM API Keys(按优先级 ANTHROPIC_API_KEY > DEEPSEEK_API_KEY > OPENAI_API_KEY 三选一即可)
# Claude(Anthropic)- https://console.anthropic.com/
ANTHROPIC_API_KEY=your-anthropic-api-key
# 可选，覆盖默认模型（默认 claude-sonnet-5）
# ANTHROPIC_MODEL=claude-haiku-4-5-20251001

# DeepSeek - https://platform.deepseek.com/
DEEPSEEK_API_KEY=your-deepseek-api-key

# OpenAI - https://platform.openai.com/
OPENAI_API_KEY=your-openai-api-key

RAWG_API_KEY=your-rawg-api-key

# NextAuth 配置
NEXTAUTH_URL=http://localhost:8000
NEXTAUTH_SECRET=generate-a-random-secret-key-using-openssl-rand-base64-32

# OAuth 提供商配置（可选 - 如需 OAuth 登录请配置）
# Google OAuth - https://console.cloud.google.com/
GOOGLE_CLIENT_ID=your-google-client-id
GOOGLE_CLIENT_SECRET=your-google-client-secret

# Discord OAuth - https://discord.com/developers/applications
DISCORD_CLIENT_ID=your-discord-client-id
DISCORD_CLIENT_SECRET=your-discord-client-secret

# Twitter/X OAuth - https://developer.twitter.com/
TWITTER_CLIENT_ID=your-twitter-client-id
TWITTER_CLIENT_SECRET=your-twitter-client-secret

# 邮件服务配置（用于邮箱验证和密码重置）
# Gmail 示例配置：
# 1. 启用两步验证
# 2. 生成应用专用密码：https://myaccount.google.com/apppasswords
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your-email@gmail.com
SMTP_PASS=your-gmail-app-password

# 其他 SMTP 服务示例：
# Outlook: smtp-mail.outlook.com, 587
# QQ邮箱: smtp.qq.com, 587
# 163邮箱: smtp.163.com, 465
